# VirusTotal API key — leave empty to disable cloud scanning
VIRUSTOTAL_API_KEY=

# SQLite database path (relative to backend/)
DB_PATH=./antivirus.db

# Max upload size in MB
MAX_FILE_SIZE_MB=100

# Quarantine directory
QUARANTINE_DIR=/tmp/av_quarantine

# API key for protecting endpoints (leave empty to disable auth in dev)
API_KEY=

# Set to true for verbose logging
DEV_MODE=false
