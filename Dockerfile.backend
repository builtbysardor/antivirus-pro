# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Build the Rust scanning core
# ─────────────────────────────────────────────────────────────────────────────
FROM rust:1.85-slim AS rust-builder

WORKDIR /build

# Cache dependency layer separately
COPY core/Cargo.toml core/Cargo.lock* ./
RUN mkdir -p src && echo "fn main() {}" > src/main.rs && touch src/lib.rs && \
    cargo build --release && \
    rm -rf src

# Now build the real source
COPY core/src ./src
RUN touch src/main.rs && cargo build --release

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Python runtime with embedded Rust binary
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runner

WORKDIR /app

# System deps for file analysis (libmagic, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    file \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Pull compiled Rust binary from Stage 1
COPY --from=rust-builder /build/target/release/av-core /usr/local/bin/av-core
RUN chmod +x /usr/local/bin/av-core

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY signatures/ ./signatures/

# Create quarantine directory with restricted permissions
RUN mkdir -p /app/quarantine && chmod 700 /app/quarantine

# Non-root user for security
RUN addgroup --system avuser && adduser --system --ingroup avuser avuser
RUN chown -R avuser:avuser /app
USER avuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
